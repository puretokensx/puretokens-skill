{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "title": "Pure Tokens specialist direct API execution contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "transport",
    "result"
  ],
  "properties": {
    "$schema": {
      "const": "https://puretokensx.com/schemas/media-execution-contract.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "balance",
        "connection",
        "models",
        "image",
        "video",
        "update",
        "evaluate",
        "audio"
      ]
    },
    "transport": {
      "oneOf": [
        {
          "$ref": "#/$defs/directTransport"
        },
        {
          "$ref": "#/$defs/updateTransport"
        }
      ]
    },
    "operations": {
      "type": "object",
      "properties": {
        "catalog": {
          "$ref": "#/$defs/request"
        },
        "submit": {
          "$ref": "#/$defs/request"
        },
        "edit": {
          "$ref": "#/$defs/request"
        },
        "status": {
          "$ref": "#/$defs/request"
        },
        "content": {
          "$ref": "#/$defs/request"
        },
        "identity": {
          "$ref": "#/$defs/request"
        },
        "read": {
          "$ref": "#/$defs/request"
        },
        "sync": {
          "$ref": "#/$defs/syncOperation"
        },
        "init": {
          "$ref": "#/$defs/initOperation"
        },
        "checkUpdate": {
          "type": "object",
          "required": [
            "commandTemplate",
            "checks"
          ],
          "properties": {
            "commandTemplate": {
              "const": "native_fetch check-update --host <current-supported-host>"
            },
            "checks": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "help": {
          "type": "object",
          "required": [
            "source",
            "networkRequests",
            "credentialReads"
          ],
          "properties": {
            "source": {
              "const": "references/usage-guide.md"
            },
            "networkRequests": {
              "const": 0
            },
            "credentialReads": {
              "const": 0
            }
          },
          "additionalProperties": false
        },
        "doctor": {
          "type": "object",
          "required": [
            "commandTemplate",
            "checks",
            "doesNotRepair"
          ],
          "properties": {
            "commandTemplate": {
              "const": "native_executor doctor --host <current-supported-host>"
            },
            "checks": {
              "type": "string"
            },
            "doesNotRepair": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "evaluationCatalog": {
          "$ref": "#/$defs/request"
        },
        "speech": {
          "$ref": "#/$defs/request"
        },
        "transcribe": {
          "$ref": "#/$defs/request"
        },
        "generate": {
          "$ref": "#/$defs/request"
        },
        "audioCatalog": {
          "$ref": "#/$defs/request"
        },
        "musicSubmit": {
          "$ref": "#/$defs/request"
        },
        "musicStatus": {
          "$ref": "#/$defs/request"
        },
        "musicContent": {
          "$ref": "#/$defs/request"
        },
        "groupGuidance": {
          "type": "object",
          "required": [
            "method",
            "url",
            "requiresConfiguredApiKey"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "url": {
              "const": "https://console.puretokensx.com/api/product/docs/model-catalog"
            },
            "requiresConfiguredApiKey": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "unsupportedInput": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameterValidation": {
      "type": "object",
      "additionalProperties": true
    },
    "inputMediaValidation": {
      "type": "object",
      "additionalProperties": true
    },
    "contentRetrieval": {
      "type": "object",
      "additionalProperties": true
    },
    "polling": {
      "type": "object",
      "additionalProperties": true
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": true
    },
    "taskState": {
      "type": "object",
      "additionalProperties": true
    },
    "submissionFailure": {
      "type": "object",
      "additionalProperties": true
    },
    "failureReceipt": {
      "$ref": "#/$defs/failureReceipt"
    },
    "continuationRecord": {
      "type": "object",
      "required": [
        "optional",
        "location",
        "commands",
        "preserves",
        "excludes",
        "resumeNeverSubmits",
        "deliveryRequiresActualHostHandoff",
        "validatesBeforeCreation",
        "downloadProofFields",
        "reuseRequiresMatchingProof",
        "legacyRecordWithoutProof",
        "unknownSubmissionNeverResubmits",
        "failureClassification",
        "redelivery"
      ],
      "properties": {
        "optional": {
          "const": true
        },
        "location": {
          "const": "explicit_absolute_user_or_workspace_artifact"
        },
        "commands": {
          "const": [
            "status",
            "wait",
            "resume",
            "content",
            "redeliver",
            "delivered"
          ]
        },
        "preserves": {
          "const": [
            "kind",
            "task_id",
            "model",
            "original_operation",
            "requested_count",
            "safe_parameters",
            "output_directory",
            "downloaded_indexes",
            "download_proofs",
            "delivered_indexes",
            "retry_not_before",
            "reconciliation_required",
            "wait_windows_completed",
            "last_failure",
            "pending_redelivery_index"
          ]
        },
        "excludes": {
          "const": [
            "credentials",
            "prompt",
            "reference_urls",
            "attachment_bytes"
          ]
        },
        "resumeNeverSubmits": {
          "const": true
        },
        "deliveryRequiresActualHostHandoff": {
          "const": true
        },
        "validatesBeforeCreation": {
          "const": true
        },
        "downloadProofFields": {
          "const": [
            "sha256",
            "bytes",
            "media_type"
          ]
        },
        "reuseRequiresMatchingProof": {
          "const": true
        },
        "legacyRecordWithoutProof": {
          "const": "continue_same_task_but_download_into_another_directory_before_handoff"
        },
        "unknownSubmissionNeverResubmits": {
          "const": true
        },
        "failureClassification": {
          "const": "reviewed_terminal_failure_only_no_raw_errors_legacy_reason_unknown"
        },
        "redelivery": {
          "const": "explicit_same_task_index_local_proof_first_never_submit_ack_after_new_handoff"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "connection"
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "required": [
              "identity"
            ],
            "properties": {
              "identity": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "models"
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "required": [
              "catalog"
            ],
            "properties": {
              "catalog": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/media/models"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image"
          }
        }
      },
      "then": {
        "required": [
          "operations",
          "unsupportedInput",
          "parameterValidation",
          "inputMediaValidation",
          "contentRetrieval",
          "polling",
          "taskIdentity",
          "taskState",
          "submissionFailure",
          "failureReceipt"
        ],
        "properties": {
          "operations": {
            "required": [
              "catalog",
              "submit",
              "edit",
              "status",
              "content"
            ],
            "properties": {
              "catalog": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/media/models"
                  }
                }
              },
              "submit": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/images/generations"
                  }
                }
              },
              "status": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "urlTemplate": {
                    "const": "https://api.puretokensx.com/v1/images/{task_id}"
                  }
                }
              },
              "content": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "urlTemplate": {
                    "const": "https://api.puretokensx.com/v1/images/{task_id}/content?index={index}"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "video"
          }
        }
      },
      "then": {
        "required": [
          "operations",
          "unsupportedInput",
          "parameterValidation",
          "inputMediaValidation",
          "contentRetrieval",
          "polling",
          "taskIdentity",
          "taskState",
          "submissionFailure",
          "failureReceipt"
        ],
        "properties": {
          "operations": {
            "required": [
              "catalog",
              "submit",
              "edit",
              "status",
              "content"
            ],
            "properties": {
              "catalog": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/media/models"
                  }
                }
              },
              "submit": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/videos"
                  }
                }
              },
              "edit": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/videos/edits"
                  }
                }
              },
              "status": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "urlTemplate": {
                    "const": "https://api.puretokensx.com/v1/videos/{task_id}"
                  }
                }
              },
              "content": {
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "urlTemplate": {
                    "const": "https://api.puretokensx.com/v1/videos/{task_id}/content"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "balance"
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "required": [
              "read"
            ],
            "properties": {
              "read": {
                "required": [
                  "method",
                  "url",
                  "requiresConfiguredApiKey",
                  "requiresBrowserSession",
                  "unitMetadataUrl",
                  "unitMetadataRequiresConfiguredApiKey",
                  "maxRequests",
                  "deadlineSeconds",
                  "responseSchema",
                  "bearerNormalization"
                ],
                "properties": {
                  "method": {
                    "const": "GET"
                  },
                  "url": {
                    "const": "https://console.puretokensx.com/api/product/console/api-keys/usage"
                  },
                  "requiresConfiguredApiKey": {
                    "const": true
                  },
                  "requiresBrowserSession": {
                    "const": false
                  },
                  "unitMetadataUrl": {
                    "const": "https://console.puretokensx.com/api/product/console/status"
                  },
                  "unitMetadataRequiresConfiguredApiKey": {
                    "const": false
                  },
                  "maxRequests": {
                    "const": 2
                  },
                  "deadlineSeconds": {
                    "const": 30
                  },
                  "responseSchema": {
                    "const": "https://puretokensx.com/schemas/balance-snapshot.schema.json"
                  },
                  "bearerNormalization": {
                    "const": "add_sk_prefix_if_missing_in_memory_for_usage_header_only"
                  }
                }
              }
            }
          },
          "transport": {
            "properties": {
              "fixedApiOrigin": {
                "const": "https://console.puretokensx.com"
              }
            }
          },
          "result": {
            "required": [
              "reportOnlyReturnedFields",
              "neverEstimate",
              "neverRetry",
              "scopeRule",
              "unit",
              "includesSubscriptionQuota",
              "calculation",
              "fallbackWhenBalanceUnavailable",
              "defaultPresentation",
              "legacyBillingFallbackAllowed",
              "balanceRejectionDoesNotInvalidateMediaConnection",
              "localFailureCodes"
            ],
            "properties": {
              "reportOnlyReturnedFields": {
                "const": true
              },
              "neverEstimate": {
                "const": true
              },
              "neverRetry": {
                "const": true
              },
              "scopeRule": {
                "const": "unlimited_quota_true_account_wallet_else_key_allowance"
              },
              "unit": {
                "const": "USD"
              },
              "includesSubscriptionQuota": {
                "const": false
              },
              "calculation": {
                "const": "each_returned_quota_divided_by_public_quota_per_unit_in_USD_never_subtract_used_from_available"
              },
              "fallbackWhenBalanceUnavailable": {
                "const": "report_balance_specific_failure_without_amount_and_preserve_working_connection"
              },
              "defaultPresentation": {
                "const": "one_line_remaining_with_wallet_or_key_allowance_label"
              },
              "legacyBillingFallbackAllowed": {
                "const": false
              },
              "balanceRejectionDoesNotInvalidateMediaConnection": {
                "const": true
              },
              "localFailureCodes": {
                "const": [
                  "balance_usage_unavailable",
                  "balance_usage_auth_rejected",
                  "balance_unit_metadata_unavailable"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update"
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "required": [
              "sync"
            ],
            "properties": {
              "sync": {
                "$ref": "#/$defs/syncOperation"
              }
            }
          },
          "result": {
            "required": [
              "installsMissingOfficialSkills",
              "upgradesOnlyManagedMatchingSkills",
              "neverOverwritesUnmanagedDirectories",
              "installsChecksumVerifiedNativeApiExecutor",
              "reportsSynchronizedVersion",
              "doesNotClaimSuccessWithoutVersionReceipt",
              "neverModifiesOfficialCheckout",
              "requiresNewHostConversationAfterSuccess"
            ],
            "properties": {
              "installsMissingOfficialSkills": {
                "const": true
              },
              "upgradesOnlyManagedMatchingSkills": {
                "const": true
              },
              "neverOverwritesUnmanagedDirectories": {
                "const": true
              },
              "installsChecksumVerifiedNativeApiExecutor": {
                "const": true
              },
              "reportsSynchronizedVersion": {
                "const": true
              },
              "doesNotClaimSuccessWithoutVersionReceipt": {
                "const": true
              },
              "neverModifiesOfficialCheckout": {
                "const": true
              },
              "requiresNewHostConversationAfterSuccess": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "image",
              "video",
              "models",
              "connection"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "transport": {
            "properties": {
              "fixedApiOrigin": {
                "const": "https://api.puretokensx.com"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audio"
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "required": [
              "speech",
              "transcribe",
              "generate"
            ],
            "properties": {
              "speech": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/audio/speech"
                  }
                }
              },
              "transcribe": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/audio/transcriptions"
                  }
                }
              },
              "generate": {
                "properties": {
                  "method": {
                    "const": "POST"
                  },
                  "url": {
                    "const": "https://api.puretokensx.com/v1/audio/generate"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "initOperation": {
      "type": "object",
      "required": [
        "commandTemplate",
        "checks",
        "usageGuide"
      ],
      "properties": {
        "commandTemplate": {
          "const": "native_executor init --host <current-supported-host>"
        },
        "checks": {
          "const": "public_identity_then_one_authenticated_catalog_check_without_displaying_configuration"
        },
        "usageGuide": {
          "const": "references/usage-guide.md"
        }
      },
      "additionalProperties": false
    },
    "directTransport": {
      "type": "object",
      "required": [
        "fixedApiOrigin",
        "usesFullApiUrls",
        "usesManagedNativeExecutor",
        "usesCurrentHostConfiguredCredential",
        "credentialSourceNeverBecomesRequestTarget",
        "neverExposesCredentialsOrHostConfiguration",
        "doesNotUseNodeRuntime",
        "doesNotUseMcpOrFallbackTransport",
        "doesNotUseComputerUseOrUiAutomation",
        "doesNotInvokeOtherMediaSkillsAsApiFallback",
        "executionStart",
        "whenManagedNativeExecutorUnavailable"
      ],
      "properties": {
        "fixedApiOrigin": {
          "enum": [
            "https://api.puretokensx.com",
            "https://console.puretokensx.com"
          ]
        },
        "usesFullApiUrls": {
          "const": true
        },
        "usesManagedNativeExecutor": {
          "const": true
        },
        "usesCurrentHostConfiguredCredential": {
          "const": true
        },
        "credentialSourceNeverBecomesRequestTarget": {
          "const": true
        },
        "neverExposesCredentialsOrHostConfiguration": {
          "const": true
        },
        "doesNotUseNodeRuntime": {
          "const": true
        },
        "doesNotUseMcpOrFallbackTransport": {
          "const": true
        },
        "doesNotUseComputerUseOrUiAutomation": {
          "const": true
        },
        "doesNotInvokeOtherMediaSkillsAsApiFallback": {
          "const": true
        },
        "executionStart": {
          "const": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request"
        },
        "whenManagedNativeExecutorUnavailable": {
          "const": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
        },
        "requiresNativeMediaByteDelivery": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "updateTransport": {
      "type": "object",
      "required": [
        "localSkillManager",
        "usesVerifiedStableRelease",
        "doesNotFallBackToSourceArchive",
        "doesNotUseCustomInstallPayload",
        "doesNotReadCredentialsOrHostConfiguration",
        "requiresPinnedOfficialSourceRevision",
        "doesNotSubmitMediaOrUseMcp"
      ],
      "properties": {
        "localSkillManager": {
          "const": true
        },
        "usesVerifiedStableRelease": {
          "const": true
        },
        "doesNotFallBackToSourceArchive": {
          "const": true
        },
        "doesNotUseCustomInstallPayload": {
          "const": true
        },
        "doesNotReadCredentialsOrHostConfiguration": {
          "const": true
        },
        "requiresPinnedOfficialSourceRevision": {
          "const": true
        },
        "doesNotSubmitMediaOrUseMcp": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://api\\.puretokensx\\.com/"
            },
            {
              "const": "https://console.puretokensx.com/api/product/console/api-keys/usage"
            }
          ]
        },
        "urlTemplate": {
          "type": "string",
          "pattern": "^https://api\\.puretokensx\\.com/"
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/v1/"
          }
        },
        "pathSource": {
          "type": "string"
        },
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "requiredBodyFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixedBody": {
          "type": "object"
        },
        "conditionalBodyFields": {
          "type": [
            "object",
            "array"
          ]
        },
        "requiresDeclaredProfileOperation": {
          "type": "string"
        },
        "inputSource": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "requiresConfiguredApiKey": {
          "type": "boolean"
        },
        "responseSchema": {
          "type": "string"
        },
        "requiresBrowserSession": {
          "const": false
        },
        "unitMetadataUrl": {
          "const": "https://console.puretokensx.com/api/product/console/status"
        },
        "unitMetadataRequiresConfiguredApiKey": {
          "const": false
        },
        "maxRequests": {
          "const": 2
        },
        "deadlineSeconds": {
          "const": 30
        },
        "bearerNormalization": {
          "const": "add_sk_prefix_if_missing_in_memory_for_usage_header_only"
        }
      },
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "urlTemplate"
          ]
        },
        {
          "required": [
            "allowedPaths"
          ]
        }
      ],
      "additionalProperties": false
    },
    "syncOperation": {
      "type": "object",
      "required": [
        "commandTemplate",
        "sourceRepository",
        "releaseManifest",
        "validationCommand",
        "directorySelector",
        "sameVersion",
        "completedCleanupFailure",
        "hostSelection",
        "targetSelection"
      ],
