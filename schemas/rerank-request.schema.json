{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/rerank-request.schema.json",
  "title": "One bounded text rerank request with explicit local output",
  "type": "object",
  "required": ["model", "query", "documents", "output_file"],
  "properties": {
    "model": { "const": "qwen3.7-text-rerank" },
    "query": { "type": "string", "maxLength": 8192, "pattern": "\\S" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 32768, "pattern": "\\S" }
    },
    "top_n": { "type": "integer", "minimum": 1, "maximum": 64 },
    "output_file": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*\\.json$(?![\\s\\S])"
    }
  },
  "additionalProperties": false
}
