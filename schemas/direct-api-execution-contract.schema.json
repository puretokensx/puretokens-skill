{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/direct-api-execution-contract.schema.json",
  "title": "Pure Tokens managed native API execution contract",
  "type": "object",
  "required": [
    "supportSummary",
    "schemaVersion",
    "apiOrigin",
    "authentication",
    "transport",
    "mediaRouting",
    "installableHosts",
    "executorCredentialAdapterHosts",
    "requiredExecutorCapabilities",
    "acceptanceScenarios",
    "userMediaInput",
    "asyncTaskHandling",
    "mediaDeliveryResourceBounds",
    "balance",
    "evaluation",
    "audio",
    "music",
    "operationsReceipts"
  ],
  "properties": {
    "$schema": {
      "const": "https://puretokensx.com/schemas/direct-api-execution-contract.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "apiOrigin": {
      "const": "https://api.puretokensx.com"
    },
    "authentication": {
      "type": "object",
      "required": [
        "usesCurrentHostConfiguredCredential",
        "executorCredentialAdapterHosts",
        "credentialUse",
        "credentialSourceMustMatchFixedPureTokensEndpoint",
        "credentialSourceNeverBecomesRequestTarget",
        "neverDisplaysCopiesStoresOrRequestsCredentials",
        "resolvesCurrentHostConnectionCredentialInMemoryForFixedRequest",
        "neverScansForCredentials"
      ],
      "properties": {
        "usesCurrentHostConfiguredCredential": {
          "const": true
        },
        "executorCredentialAdapterHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "credentialUse": {
          "const": "in_memory_only_for_fixed_puretokens_api_requests"
        },
        "credentialSourceMustMatchFixedPureTokensEndpoint": {
          "const": true
        },
        "credentialSourceNeverBecomesRequestTarget": {
          "const": true
        },
        "neverDisplaysCopiesStoresOrRequestsCredentials": {
          "const": true
        },
        "resolvesCurrentHostConnectionCredentialInMemoryForFixedRequest": {
          "const": true
        },
        "neverScansForCredentials": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": [
        "usesFullApiUrls",
        "usesManagedNativeExecutor",
        "executorIsOneShot",
        "doesNotRequireNode",
        "doesNotUseMcp",
        "doesNotUseLocalProxyOrSidecar",
        "doesNotUseFallbackEndpoint",
        "doesNotUseComputerUseOrUiAutomation",
        "doesNotInvokeOtherMediaSkillsAsApiFallback",
        "executionStart",
        "whenManagedNativeExecutorUnavailable"
      ],
      "properties": {
        "usesFullApiUrls": {
          "const": true
        },
        "usesManagedNativeExecutor": {
          "const": true
        },
        "executorIsOneShot": {
          "const": true
        },
        "doesNotRequireNode": {
          "const": true
        },
        "doesNotUseMcp": {
          "const": true
        },
        "doesNotUseLocalProxyOrSidecar": {
          "const": true
        },
        "doesNotUseFallbackEndpoint": {
          "const": true
        },
        "doesNotUseComputerUseOrUiAutomation": {
          "const": true
        },
        "doesNotInvokeOtherMediaSkillsAsApiFallback": {
          "const": true
        },
        "executionStart": {
          "const": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request"
        },
        "whenManagedNativeExecutorUnavailable": {
          "const": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
        }
      },
      "additionalProperties": false
    },
    "mediaRouting": {
      "type": "object",
      "required": [
        "imageAndVideoRequestsPreferPureTokensSpecialists",
        "imageSkill",
        "videoSkill",
        "priority",
        "afterSpecialistSelection",
        "connectionContext",
        "metadataLimitation"
      ],
      "properties": {
        "imageAndVideoRequestsPreferPureTokensSpecialists": {
          "const": true
        },
        "imageSkill": {
          "const": "puretokens-image"
        },
        "videoSkill": {
          "const": "puretokens-video"
        },
        "priority": {
          "const": "when_current_host_connection_uses_puretokens_select_the_matching_puretokens_specialist_before_generic_imagegen_imagen_or_video_skills"
        },
        "afterSpecialistSelection": {
          "const": "never_fall_back_to_a_generic_media_skill"
        },
        "connectionContext": {
          "const": "managed_native_executor_resolves_one_matching_current_connection_credential_privately_for_the_fixed_request"
        },
        "metadataLimitation": {
          "const": "skill_metadata_expresses_routing_priority_but_cannot_override_a_host_that_ignores_installed_skill_selection"
        }
      },
      "additionalProperties": false
    },
    "installableHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "executorCredentialAdapterHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "requiredExecutorCapabilities": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixed_full_url_request",
          "json_task_response",
          "same_task_status_read",
          "native_media_byte_delivery",
          "bounded_local_resource_use"
        ]
      }
    },
    "acceptanceScenarios": {
      "type": "array",
      "minItems": 5
    },
    "userMediaInput": {
      "type": "object"
    },
    "asyncTaskHandling": {
      "type": "object",
      "required": [
        "providerProtocolOwner",
        "publicImageContract",
        "asyncFlagMeaning",
        "neverSendInternalWorkspaceDeliveryHeaders",
        "neverSwitchToSynchronousProviderTransport"
      ],
      "properties": {
        "providerProtocolOwner": {
          "const": "gateway"
        },
        "publicImageContract": {
          "const": "submit_once_receive_durable_task_id_then_read_same_task_status_and_protected_content"
        },
        "asyncFlagMeaning": {
          "const": "product_task_compatibility_not_supplier_async_capability"
        },
        "neverSendInternalWorkspaceDeliveryHeaders": {
          "const": true
        },
        "neverSwitchToSynchronousProviderTransport": {
          "const": true
        }
      }
    },
    "supportSummary": {
      "const": {
        "format": "puretokens-support-v1",
        "source": "current_invocation_receipt_and_latest_http_attempt_only",
        "requestIdHeaders": [
          "X-Request-ID",
          "X-Oneapi-Request-Id"
        ],
        "requestIdRule": "one_canonical_lowercase_uuid_legacy_only_if_standard_absent_omit_conflicts",
        "neverUseUpstreamRequestId": true,
        "noAdditionalIO": true,
        "noAutomaticExportOrUpload": true,
        "neverUseAsTaskRecordOrIdempotencyKey": true,
        "privateSupportOnly": true
      }
    },
    "mediaDeliveryResourceBounds": {
      "type": "object"
    },
    "balance": {
      "type": "object",
      "required": [
        "url",
        "method",
        "requiresConfiguredApiKey",
        "requiresBrowserSession",
        "responseSchema",
        "unitMetadataUrl",
        "unitMetadataRequiresConfiguredApiKey",
        "maxRequests",
        "deadlineSeconds",
        "scopeRule",
        "unit",
        "includesSubscriptionQuota",
        "calculation",
        "fallback",
        "bearerNormalization"
      ],
      "properties": {
        "url": {
          "const": "https://console.puretokensx.com/api/product/console/api-keys/usage"
        },
        "method": {
          "const": "GET"
        },
        "requiresConfiguredApiKey": {
          "const": true
        },
        "requiresBrowserSession": {
          "const": false
        },
        "responseSchema": {
          "const": "schemas/balance-snapshot.schema.json"
        },
        "unitMetadataUrl": {
          "const": "https://console.puretokensx.com/api/product/console/status"
        },
        "unitMetadataRequiresConfiguredApiKey": {
          "const": false
        },
        "maxRequests": {
          "const": 2
        },
        "deadlineSeconds": {
          "const": 30
        },
        "scopeRule": {
          "const": "unlimited_quota_true_account_wallet_else_key_allowance"
        },
        "unit": {
          "const": "USD"
        },
        "includesSubscriptionQuota": {
          "const": false
        },
        "calculation": {
          "const": "each_returned_quota_divided_by_public_quota_per_unit_in_USD_never_subtract_used_from_available"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "bearerNormalization": {
          "const": "add_sk_prefix_if_missing_in_memory_for_usage_header_only"
        }
      },
      "additionalProperties": false
    },
    "optionalCommands": {
      "type": "object"
    },
    "evaluation": {
      "const": {
        "method": "POST",
        "url": "https://api.puretokensx.com/typesafe/v1/systemone",
        "command": "evaluate",
        "deadlineSeconds": 90,
        "maxRequests": 1,
        "requestSchema": "schemas/evaluation-request.schema.json",
        "responseSchema": "schemas/evaluation-receipt.schema.json",
        "modelDiscoveryUrl": "https://api.puretokensx.com/v1/models",
        "modelDiscoveryScope": "explicit_reviewed_model_visibility_only",
        "synchronous": true,
        "neverAutomaticallyRetries": true,
        "onePostPerInvocation": true,
        "neverPoll": true
      }
    },
    "unimplementedServerDependencies": {
      "type": "object"
    },
    "audio": {
      "const": {
        "commands": [
          "audio",
          "audio-verify"
        ],
        "urls": [
          "https://api.puretokensx.com/v1/audio/speech",
          "https://api.puretokensx.com/v1/audio/transcriptions",
          "https://api.puretokensx.com/v1/audio/generate"
        ],
        "method": "POST",
        "deadlineSeconds": 90,
        "maxRequests": 1,
        "synchronous": true,
        "neverAutomaticallyRetries": true,
        "neverPoll": true,
        "modelDiscoveryUrl": "https://api.puretokensx.com/v1/models",
        "modelDiscoveryScope": "explicit_reviewed_model_visibility_only",
        "requestSchema": "schemas/audio-request.schema.json",
        "responseSchema": "schemas/audio-receipt.schema.json",
        "verifySchema": "schemas/audio-artifact-verify-request.schema.json",
        "verifyLocalOnly": true,
        "nativeAudioBytesRequired": true,
        "downloadIsNotDelivery": true
      }
    },
    "operationsReceipts": {
      "const": {
        "enabledByDefault": false,
        "enablement": "PTP_OPERATIONS_RECEIPTS=1",
        "url": "https://console.puretokensx.com/api/product/analytics/client-receipts",
        "method": "POST",
        "schemaVersion": 1,
        "fields": [
          "schemaVersion",
          "id",
          "source",
          "event",
          "platform",
          "occurredAt"
        ],
        "source": "skill",
        "events": [
          "installed",
          "connection_verified",
          "execution_succeeded",
          "execution_failed"
        ],
        "authentication": "none",
        "readsHostConfiguration": false,
        "persistentIdentifier": false,
        "deadlineSeconds": 1,
        "retries": 0,
        "durableQueue": false,
        "changesBusinessResult": false,
        "asyncSuccessMeaning": "submission_accepted_not_output_delivered",
        "initBudget": "outside_existing_two_reads_and_twenty_seconds"
      }
    },
    "music": {
      "const": {
        "kind": "music",
        "model": "stepaudio-3-music-preview",
        "submitUrl": "https://api.puretokensx.com/v1/audio/music/submit",
        "statusUrlTemplate": "https://api.puretokensx.com/v1/audio/music/tasks/{task_id}",
        "contentUrlTemplate": "https://api.puretokensx.com/v1/audio/music/tasks/{task_id}/content",
        "asynchronous": true,
        "onePostPerSubmission": true,
        "neverAutomaticallyResubmits": true,
        "recordRequiredBySkill": true,
        "recordExcludesPromptAndLyrics": true,
        "apiTaskBoundToOwnerAndOriginatingKey": true,
        "maxOutputBytes": 33554432,
        "artifactRetentionSeconds": 86400,
        "retentionStarts": "gateway_artifact_saved_at",
        "waitWindowMaxReads": 7,
        "waitWindowDeadlineSeconds": 300,
        "maxAutomaticWaitWindows": 2,
        "reconciliationStopsAutomaticContinuation": true,
        "downloadIsNotDelivery": true
      }
    },
    "modelGroupGuidance": {
      "type": "object",
      "required": [
        "command",
        "url",
        "method",
        "requiresConfiguredApiKey",
        "readsHostConfiguration",
        "requiresBrowserSession",
        "maxRequests",
        "deadlineSeconds",
        "followsRedirects",
        "neverRetry",
        "requestSchema",
        "responseSchema",
        "source",
        "permissionVerified",
        "accountEligibilityVerified",
        "missingOrConflictingMapping",
        "configurationChange",
        "ordinaryGenerationPreflight",
        "automaticTaskSubmission"
      ],
      "properties": {
        "command": {
          "const": "model-groups"
        },
        "url": {
          "const": "https://console.puretokensx.com/api/product/docs/model-catalog"
        },
        "method": {
          "const": "GET"
        },
        "requiresConfiguredApiKey": {
          "const": false
        },
        "readsHostConfiguration": {
          "const": false
        },
        "requiresBrowserSession": {
          "const": false
        },
        "maxRequests": {
          "const": 1
        },
        "deadlineSeconds": {
          "const": 20
        },
        "followsRedirects": {
          "const": false
        },
        "neverRetry": {
          "const": true
        },
        "requestSchema": {
          "const": "schemas/model-groups-request.schema.json"
        },
        "responseSchema": {
          "const": "schemas/model-groups-receipt.schema.json"
        },
        "source": {
          "const": "exact_model_name_group_guidance_public_catalog_with_switch_display_names"
        },
        "permissionVerified": {
          "const": false
        },
        "accountEligibilityVerified": {
          "const": false
        },
        "missingOrConflictingMapping": {
          "const": "generic_exact_model_guidance_without_invented_group_names"
        },
        "configurationChange": {
          "const": "user_preserves_existing_groups_selects_allowed_group_and_verifies_applies_in_switch"
        },
        "ordinaryGenerationPreflight": {
          "const": false
        },
        "automaticTaskSubmission": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
