{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/host-delivery.schema.json",
  "title": "Conditional host media handoff guidance, not real-host acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "reviewedAt", "scope", "defaultProtocol", "ordinaryGenerationPreflight", "unknownMeansUnsupported", "nativeFileRequired", "protocols", "hosts"],
  "properties": {
    "$schema": { "const": "https://puretokensx.com/schemas/host-delivery.schema.json" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": { "const": "delivery_guidance_not_real_host_acceptance" },
    "defaultProtocol": { "const": "session-native" },
    "ordinaryGenerationPreflight": { "const": false },
    "unknownMeansUnsupported": { "const": false },
    "nativeFileRequired": { "const": true },
    "protocols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/protocol" } },
    "hosts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/host" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "modes", "media", "requirement", "action", "confirmation", "evidenceKind", "evidence", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["desktop-local", "ide-local", "cli-local", "remote"] } },
        "media": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["image", "video", "audio"] } },
        "requirement": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "confirmation": { "$ref": "#/$defs/text" },
        "evidenceKind": { "enum": ["current_session_contract", "official_documentation"] },
        "evidence": { "$ref": "#/$defs/text" },
        "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "protocols"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
      }
    }
  }
}
