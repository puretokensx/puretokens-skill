{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/rerank-output.schema.json",
  "title": "Ranking with original document indices and unnormalized scores",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["rank", "index", "relevance_score"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 64 },
          "index": { "type": "integer", "minimum": 0, "maximum": 63 },
          "relevance_score": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
