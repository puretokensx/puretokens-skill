{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/embedding-output.schema.json",
  "title": "One row in an explicitly saved embedding JSONL artifact",
  "type": "object",
  "required": ["index", "dimensions", "embedding"],
  "properties": {
    "index": { "type": "integer", "minimum": 0, "maximum": 63 },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "embedding": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "type": "number" }
    }
  },
  "additionalProperties": false
}
