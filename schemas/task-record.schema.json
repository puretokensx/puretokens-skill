{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/task-record.schema.json",
  "title": "Explicit user/workspace continuation artifact; no credentials, prompts or reference media",
  "type": "object",
  "required": [
    "format",
    "kind"
  ],
  "properties": {
    "format": {
      "const": "puretokens-task-v1"
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "music"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,255}$(?![\\s\\S])"
    },
    "model": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+(\\([A-Za-z0-9_.-]+\\))?$(?![\\s\\S])"
    },
    "original_operation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$",
      "description": "Original generate/edit or declared media operation, preserved across same-task commands."
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "parameters": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "size": {
          "type": "string",
          "pattern": "^(auto|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
        },
        "image_size": {
          "type": "string",
          "pattern": "^[1-9][0-9]?[Kk]$"
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^(auto|adaptive|[1-9][0-9]{0,2}:[1-9][0-9]{0,2})$"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "resolution": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}[pPkK]$"
        },
        "generate_audio": {
          "type": "boolean"
        },
        "strength": {
          "type": "string",
          "pattern": "^(LOW|MID|HIGH)$"
        },
        "quality": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "output_format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "response_format": {
          "enum": [
            "url",
            "mp3",
            "wav"
          ]
        },
        "instrumental": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "pending",
        "queued",
        "processing",
        "running",
        "in_progress",
        "completed",
        "succeeded",
        "success",
        "failed",
        "cancelled",
        "canceled",
        "expired",
        "error",
        "unknown"
      ]
    },
    "submission_outcome": {
      "enum": [
        "accepted",
        "rejected",
        "unknown",
        "not_submitted"
      ]
    },
    "reconciliation_required": {
      "type": "boolean"
    },
    "retry_not_before": {
      "type": "string",
      "format": "date-time",
      "description": "Existing optional next-read lower bound; retains initial image or API waiting time without restarting it on resume."
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "downloaded": {
      "type": "object",
      "patternProperties": {
        "^[0-5]$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "delivered": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      }
    },
    "download_proofs": {
      "type": "object",
      "patternProperties": {
        "^[0-5]$": {
          "type": "object",
          "required": [
            "sha256",
            "bytes",
            "media_type"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "media_type": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif",
                "image/avif",
                "video/mp4",
                "video/webm",
                "audio/mpeg",
                "audio/wav"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wait_windows_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Saturated count of completed foreground wait windows. Preserve across continuation; two ends automatic continuation."
    },
    "last_failure": {
      "type": "object",
      "description": "Curated evidence from a confirmed terminal task result. Temporary HTTP read failures never overwrite it; no original message is persisted.",
      "required": [
        "category",
        "phase",
        "task_status"
      ],
      "properties": {
        "category": {
          "enum": [
            "unknown",
            "quota",
            "balance",
            "authentication",
            "model_permission",
            "permission",
            "model_unavailable",
            "invalid_request",
            "content_policy",
            "rate_limit",
            "service_unavailable",
            "task_unavailable"
          ]
        },
        "phase": {
          "enum": [
            "submission",
            "status"
          ]
        },
        "task_status": {
          "enum": [
            "failed",
            "cancelled",
            "canceled",
            "expired",
            "error"
          ]
        },
        "api_error_code": {
          "enum": [
            "insufficient_quota",
            "insufficient_balance",
            "auth_required",
            "invalid_api_key",
            "authentication_error",
            "model_not_allowed",
            "permission_denied",
            "query_denied",
            "model_not_found",
            "invalid_request",
            "invalid_request_error",
            "invalid_parameter",
            "unsupported_parameter",
            "unsupported_operation",
            "content_policy_violation",
            "content_moderation",
            "moderation_blocked",
            "rate_limit",
            "rate_limited",
            "rate_limit_exceeded",
            "upstream_unavailable",
            "service_unavailable",
            "internal_error",
            "task_not_found",
            "task_expired"
          ]
        }
      },
      "additionalProperties": false
    },
    "pending_redelivery_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "One explicitly requested repeat handoff. Preserve historical delivered indexes and clear only after delivered acknowledges this index."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "music"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "const": "stepaudio-3-music-preview"
          },
          "requested_count": {
            "maximum": 1
          },
          "index": {
            "const": 0
          },
          "parameters": {
            "type": "object",
            "properties": {
              "instrumental": {
                "type": "boolean"
              },
              "response_format": {
                "enum": [
                  "mp3",
                  "wav"
                ]
              }
            },
            "additionalProperties": false
          },
          "pending_redelivery_index": {
            "const": 0
          }
        }
      }
    }
  ]
}
