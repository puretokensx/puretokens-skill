{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/model-query.schema.json",
  "title": "Explicit local filter for one authenticated models read",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "image",
        "video",
        "evaluation",
        "audio",
        "embedding",
        "rerank"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+(\\([A-Za-z0-9_.-]+\\))?$(?![\\s\\S])"
    },
    "operation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evaluation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": ""
          },
          "parameters": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audio"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "speech",
              "transcribe",
              "generate",
              "music"
            ]
          },
          "parameters": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "embedding",
              "rerank"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": ""
          },
          "parameters": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
