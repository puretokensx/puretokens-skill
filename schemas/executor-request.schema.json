{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native media submit/preflight or same-task request",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "image",
        "video",
        "music"
      ]
    },
    "operation": {
      "enum": [
        "generate",
        "edit",
        "continue"
      ]
    },
    "media_operation": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+(\\([A-Za-z0-9_.-]+\\))?$(?![\\s\\S])"
    },
    "prompt": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,255}$(?![\\s\\S])"
    },
    "task_status": {
      "enum": [
        "pending",
        "queued",
        "processing",
        "running",
        "in_progress",
        "completed",
        "succeeded",
        "success",
        "failed",
        "cancelled",
        "canceled",
        "expired",
        "error",
        "unknown"
      ]
    },
    "requested_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Zero/omitted is unknown on continuation; submission infers n or one. Image content requires the accepted positive count."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "output_dir": {
      "type": "string"
    },
    "poll": {
      "type": "object",
      "properties": {
        "max_status_reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "path"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "original_operation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$",
      "description": "Original generate/edit or declared media operation, preserved across same-task commands."
    },
    "retry_not_before": {
      "type": "string",
      "format": "date-time",
      "description": "Copy the exact next-read lower bound from the receipt or record; may reflect the initial image delay or API Retry-After."
    },
    "reconciliation_required": {
      "type": "boolean"
    },
    "wait_windows_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Saturated count of completed foreground wait windows. Preserve across continuation; two ends automatic continuation."
    }
  },
  "additionalProperties": false,
  "$id": "https://puretokensx.com/schemas/executor-request.schema.json",
  "anyOf": [
    {
      "required": [
        "task_id"
      ]
    },
    {
      "required": [
        "operation",
        "model",
        "prompt"
      ],
      "properties": {
        "operation": {
          "enum": [
            "generate",
            "edit"
          ]
        },
        "prompt": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "video"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "poll": {
            "properties": {
              "max_status_reads": {
                "maximum": 7
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "enum": [
              "generate",
              "edit"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "task_id"
              ]
            },
            {
              "required": [
                "task_status"
              ]
            },
            {
              "required": [
                "original_operation"
              ]
            },
            {
              "required": [
                "retry_not_before"
              ]
            },
            {
              "required": [
                "reconciliation_required"
              ]
            }
          ]
        },
        "properties": {
          "index": {
            "const": 0
          },
          "wait_windows_completed": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "music"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "const": "stepaudio-3-music-preview"
          },
          "requested_count": {
            "maximum": 1
          },
          "index": {
            "const": 0
          },
          "operation": {
            "enum": [
              "generate",
              "continue"
            ]
          },
          "media_operation": {
            "const": ""
          },
          "attachments": {
            "maxItems": 0
          },
          "poll": {
            "properties": {
              "max_status_reads": {
                "maximum": 7
              }
            }
          }
        },
        "required": [
          "model"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "task_id"
              ]
            },
            "then": {
              "properties": {
                "prompt": {
                  "const": ""
                },
                "parameters": {
                  "type": "object",
                  "properties": {
                    "instrumental": {
                      "type": "boolean"
                    },
                    "response_format": {
                      "enum": [
                        "mp3",
                        "wav"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "else": {
              "required": [
                "parameters",
                "output_dir"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                },
                "output_dir": {
                  "type": "string",
                  "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]+$"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "instrumental",
                    "response_format"
                  ],
                  "properties": {
                    "instrumental": {
                      "type": "boolean"
                    },
                    "response_format": {
                      "enum": [
                        "mp3",
                        "wav"
                      ]
                    },
                    "lyrics": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "instrumental": {
                            "const": true
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "lyrics": {
                            "const": ""
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
