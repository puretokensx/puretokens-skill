{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/embedding-request.schema.json",
  "title": "One bounded text embedding request with explicit local output",
  "type": "object",
  "required": ["model", "input", "output_file"],
  "properties": {
    "model": { "enum": ["qwen3.7-text-embedding", "qwen3.7-text-embedding-flash"] },
    "input": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 32768, "pattern": "\\S" }
    },
    "output_file": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*\\.jsonl$(?![\\s\\S])"
    }
  },
  "additionalProperties": false
}
