{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/embedding-request.schema.json",
  "title": "One bounded text embedding request with explicit local output",
  "type": "object",
  "required": ["model", "input", "output_file"],
  "properties": {
    "model": { "enum": ["qwen3.7-text-embedding", "qwen3.7-text-embedding-flash", "voyage-4-large"], "default": "qwen3.7-text-embedding" },
    "input_type": { "enum": ["query", "document"] },
    "output_dimension": { "type": "integer", "enum": [256, 512, 1024, 2048] },
    "input": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 32768, "pattern": "\\S" }
    },
    "output_file": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*\\.jsonl$(?![\\s\\S])"
    }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "model": { "const": "voyage-4-large" } }, "required": ["model"] },
    "then": {},
    "else": { "properties": { "input_type": false, "output_dimension": false } }
  }]
}
