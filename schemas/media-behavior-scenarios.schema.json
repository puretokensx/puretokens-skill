{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/media-behavior-scenarios.schema.json",
  "title": "Pure Tokens specialist behavior scenarios",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "https://puretokensx.com/schemas/media-behavior-scenarios.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "balance",
        "connection",
        "models",
        "image",
        "video",
        "update",
        "evaluate",
        "audio",
        "embedding",
        "rerank"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
