{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "embedding",
  "transport": {
    "fixedApiOrigin": "https://api.puretokensx.com",
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "credentialSourceNeverBecomesRequestTarget": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "executionStart": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request",
    "whenManagedNativeExecutorUnavailable": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
  },
  "operations": {
    "submit": {
      "method": "POST",
      "url": "https://api.puretokensx.com/v1/embeddings",
      "requiredBodyFields": ["model", "input", "encoding_format"],
      "fixedBody": {
        "encoding_format": "float"
      }
    }
  },
  "result": {
    "synchronous": true,
    "deadlineSeconds": 90,
    "neverAutomaticallyRetries": true,
    "onePostPerInvocation": true,
    "neverPoll": true,
    "unknownSubmissionStops": true,
    "supportExcludesInputsAndResults": true,
    "validatesRequestAndNewOutputBeforeCredentials": true,
    "outputFormat": "jsonl",
    "outputFields": ["index", "dimensions", "embedding"],
    "outputOrder": "original_zero_based_input_index",
    "chatSummaryFields": ["item_count", "dimensions", "path"]
  },
  "parameterValidation": {
    "requestFields": ["model", "input", "output_file"],
    "reviewedModelIds": ["qwen3.7-text-embedding", "qwen3.7-text-embedding-flash"],
    "maxRequestBytes": 1048576,
    "maxResponseBytes": 2097152,
    "minItems": 1,
    "maxItems": 64,
    "maxTextRunes": 32768,
    "outputFile": "explicit_absolute_new_jsonl_file_existing_writable_parent"
  }
}
