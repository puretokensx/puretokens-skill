{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "update",
  "transport": {
    "localSkillManager": true,
    "usesVerifiedStableRelease": true,
    "doesNotFallBackToSourceArchive": true,
    "doesNotUseCustomInstallPayload": true,
    "doesNotReadCredentialsOrHostConfiguration": true,
    "requiresPinnedOfficialSourceRevision": true,
    "doesNotSubmitMediaOrUseMcp": true
  },
  "operations": {
    "sync": {
      "commandTemplate": "native_fetch install_or_update --host <current-supported-host>",
      "sourceRepository": "https://github.com/puretokensx/puretokens-skill.git",
      "releaseManifest": "https://github.com/puretokensx/puretokens-skill/releases/latest/download/release-manifest.json",
      "bootstrapMetadata": "https://api.github.com/repos/puretokensx/puretokens-skill/releases/latest",
      "bootstrapValidation": "unique_uploaded_stable_asset_exact_repository_url_size_sha256_digest_before_execution",
      "bootstrapMetadataReuse": {
        "options": ["--release-metadata", "-ReleaseMetadata"],
        "scope": "same_invocation_official_https_metadata_only_not_historical_cache",
        "maxBytes": 2097152,
        "requiresAbsoluteRegularNonLinkedFile": true,
        "validatesStableSelfAssetSizeAndDigest": true,
        "replacesPreExecutionVerification": false,
        "additionalMetadataRequests": 0,
        "pinsRemainingAssetsToSnapshot": true
      },
      "downloadFallback": {
        "httpStatuses": [502, 503, 504],
        "metadataRequestsPerInvocation": 1,
        "assetRequestsPerFailedFile": 1,
        "reuseVerifiedRouteForRemainingPinnedAssets": true,
        "routeScope": "current_invocation_only",
        "source": "official_anonymous_github_asset_api_same_pinned_release",
        "requiresToken": false,
        "doesNotRetryAlternateOrBypassPermissions": true
      },
      "validationCommand": "pin_stable_manifest_verify_selector_and_platform_package_then_native_sync",
      "directorySelector": "download_checksum_verified_selector_from_the_same_stable_release",
      "sameVersion": "verify_release_executor_checksum_and_all_managed_inventories_then_no_download_sync_or_init",
      "completedCleanupFailure": "report_cleanup_pending_preserve_committed_files_attempt_lock_release_and_continue_single_init_without_retrying_denied_deletion",
      "initOnlyFailure": "preserve_committed_install_report_init_unverified_without_recovery_reinstall_or_retry",
      "localFailureReceipt": ["stage", "error_code", "installation_status", "installed_files_changed", "next_step"],
      "hostSelection": {
        "whenNoHostOrTarget": "bounded_direct_launcher_detection",
        "maxProcessQueries": 8,
        "readProcessFields": [
          "name",
          "parentId"
        ],
        "automaticHosts": [
          "codex",
          "opencode",
          "grok-build",
          "qoder"
        ],
        "unknownLauncher": "stop_before_release_download_or_installation_writes_then_confirm_missing_client",
        "explicitHostOrTarget": "preserve_without_detection",
        "doesNotReadConfigurationOrCommandLines": true,
        "doesNotIdentifyChatModelOrVerifyAPI": true,
        "diagnosticCommand": "native_fetch detect-host"
      },
      "targetSelection": {
        "default": "verified_release_selector",
        "workspaceTargetRequiredFor": [
          "octop"
        ],
        "missingWorkspaceTarget": "stop_before_release_download_or_installation_writes_with_confirm_workspace_target",
        "confirmedCustomTarget": "preserve"
      }
    },
    "init": {
      "commandTemplate": "native_executor init --host <current-supported-host>",
      "checks": "public_identity_then_one_authenticated_catalog_check_without_displaying_configuration",
      "totalDeadlineSeconds": 20,
      "maxRequests": 2,
      "usageGuide": "references/usage-guide.md"
    },
    "intentRouting": {
      "generalConnectionCheck": "init",
      "explicitAuthenticationCheck": "init",
      "installationDiagnostics": "doctor",
      "usageQuestion": "local_guide_only",
      "doNotChainChecksForOneIntent": true,
      "publicServiceIdentity": "connection_public_identity_only",
      "productIntroduction": "local_guide_only",
      "gettingStarted": "local_guide_only"
    },
    "checkUpdate": {
      "commandTemplate": "native_fetch check-update --host <current-supported-host>",
      "checks": "stable_release_manifest_verified_selector_and_managed_installed_version_without_sync_or_init"
    },
    "help": {
      "source": "references/usage-guide.md",
      "networkRequests": 0,
      "credentialReads": 0
    },
    "doctor": {
      "commandTemplate": "native_executor doctor --host <current-supported-host>",
      "checks": "known_local_skill_directories_versions_duplicates_then_existing_read_only_init",
      "doesNotRepair": true
    }
  },
  "result": {
    "installsMissingOfficialSkills": true,
    "upgradesOnlyManagedMatchingSkills": true,
    "neverOverwritesUnmanagedDirectories": true,
    "installsChecksumVerifiedNativeApiExecutor": true,
    "reportsSynchronizedVersion": true,
    "doesNotClaimSuccessWithoutVersionReceipt": true,
    "neverModifiesOfficialCheckout": true,
    "requiresNewHostConversationAfterSuccess": false,
    "helpOnlyDoesNotInvokeInit": true,
    "helpOnlyDoesNotInvokeExecutor": true,
    "helpOnlyDoesNotRequireHostOrConnection": true
  }
}
