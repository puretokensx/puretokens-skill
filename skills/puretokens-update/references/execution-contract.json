{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "update",
  "transport": {
    "localSkillManager": true,
    "usesVerifiedStableRelease": true,
    "doesNotFallBackToSourceArchive": true,
    "doesNotUseCustomInstallPayload": true,
    "doesNotReadCredentialsOrHostConfiguration": true,
    "requiresPinnedOfficialSourceRevision": true,
    "doesNotSubmitMediaOrUseMcp": true
  },
  "operations": {
    "sync": {
      "commandTemplate": "native_fetch install_or_update --host <current-supported-host>",
      "sourceRepository": "https://github.com/puretokensx/puretokens-skill.git",
      "releaseManifest": "https://github.com/puretokensx/puretokens-skill/releases/latest/download/release-manifest.json",
      "validationCommand": "pin_stable_manifest_verify_selector_and_platform_package_then_native_sync",
      "directorySelector": "download_checksum_verified_selector_from_the_same_stable_release",
      "sameVersion": "verify_release_executor_checksum_and_all_managed_inventories_then_no_download_sync_or_init",
      "completedCleanupFailure": "report_cleanup_pending_preserve_committed_files_attempt_lock_release_and_continue_single_init_without_retrying_denied_deletion"
    },
    "init": {
      "commandTemplate": "native_executor init --host <current-supported-host>",
      "checks": "public_identity_then_one_authenticated_catalog_check_without_displaying_configuration",
      "totalDeadlineSeconds": 20,
      "maxRequests": 2,
      "usageGuide": "references/usage-guide.md"
    },
    "intentRouting": {
      "generalConnectionCheck": "connection_public_identity_only",
      "explicitAuthenticationCheck": "init",
      "installationDiagnostics": "doctor",
      "usageQuestion": "local_guide_only",
      "doNotChainChecksForOneIntent": true
    },
    "checkUpdate": {
      "commandTemplate": "native_fetch check-update --host <current-supported-host>",
      "checks": "stable_release_manifest_verified_selector_and_managed_installed_version_without_sync_or_init"
    },
    "help": {
      "source": "references/usage-guide.md",
      "networkRequests": 0,
      "credentialReads": 0
    },
    "doctor": {
      "commandTemplate": "native_executor doctor --host <current-supported-host>",
      "checks": "known_local_skill_directories_versions_duplicates_then_existing_read_only_init",
      "doesNotRepair": true
    }
  },
  "result": {
    "installsMissingOfficialSkills": true,
    "upgradesOnlyManagedMatchingSkills": true,
    "neverOverwritesUnmanagedDirectories": true,
    "installsChecksumVerifiedNativeApiExecutor": true,
    "reportsSynchronizedVersion": true,
    "doesNotClaimSuccessWithoutVersionReceipt": true,
    "neverModifiesOfficialCheckout": true,
    "requiresNewHostConversationAfterSuccess": true,
    "helpOnlyDoesNotInvokeInit": true
  }
}
