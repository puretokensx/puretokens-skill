{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "image",
  "catalogUpdatedAt": "2026-11-08",
  "catalogCapturedAt": "2026-11-08T13:27:39.712Z",
  "id": "grok-imagine-image",
  "parameterSchema": {
    "properties": {
      "prompt": {
        "type": "string",
        "required": true
      },
      "n": {
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 1
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "16:9"
        ],
        "default": "16:9"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "1k",
          "2k"
        ],
        "default": "1k"
      }
    },
    "operations": {
      "image_generation": {
        "request": {
          "method": "POST",
          "path": "/v1/images/generations",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt"
        ]
      },
      "image_edit": {
        "request": {
          "method": "POST",
          "path": "/v1/images/edits",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "image"
        ],
        "inputs": {
          "image": {
            "field": "image",
            "required": true,
            "minItems": 1,
            "maxItems": 1,
            "transports": [
              "https_url"
            ]
          }
        }
      }
    }
  }
}
