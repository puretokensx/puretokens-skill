{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "image",
  "catalogUpdatedAt": "2026-11-07",
  "catalogCapturedAt": "2026-11-07T09:20:36.335Z",
  "id": "gemini-3.1-flash-image",
  "parameterSchema": {
    "properties": {
      "n": {
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 1
      },
      "prompt": {
        "type": "string",
        "required": true
      },
      "image_size": {
        "type": "string",
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "default": "1K"
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "1:1",
          "2:3",
          "3:2",
          "3:4",
          "4:3",
          "4:5",
          "5:4",
          "9:16",
          "16:9",
          "21:9",
          "1:4",
          "4:1",
          "1:8",
          "8:1"
        ],
        "default": "1:1"
      }
    },
    "operations": {
      "image_edit": {
        "request": {
          "method": "POST",
          "path": "/v1/images/edits",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "images"
        ],
        "inputs": {
          "images": {
            "field": "images",
            "required": true,
            "minItems": 1,
            "maxItems": 14,
            "transports": [
              "https_url",
              "local_file_data_url"
            ]
          }
        }
      },
      "image_generation": {
        "request": {
          "method": "POST",
          "path": "/v1/images/generations",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt"
        ]
      }
    },
    "constraints": {}
  }
}
