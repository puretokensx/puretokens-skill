{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "models",
  "transport": {
    "fixedApiOrigin": "https://api.puretokensx.com",
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "credentialSourceNeverBecomesRequestTarget": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "executionStart": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request",
    "whenManagedNativeExecutorUnavailable": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
  },
  "operations": {
    "catalog": {
      "method": "GET",
      "url": "https://api.puretokensx.com/v1/media/models"
    },
    "evaluationCatalog": {
      "method": "GET",
      "url": "https://api.puretokensx.com/v1/models"
    },
    "audioCatalog": {
      "method": "GET",
      "url": "https://api.puretokensx.com/v1/models"
    },
    "groupGuidance": {
      "method": "GET",
      "url": "https://console.puretokensx.com/api/product/docs/model-catalog",
      "requiresConfiguredApiKey": false
    }
  },
  "result": {
    "doesNotSubmitMediaTasks": true,
    "neverRetry": true,
    "noStaticCatalogFallback": true,
    "mediaCompatibilityShortlistsRequireDeclaredCapabilityAndInputSchema": true,
    "optionalFilterFields": [
      "kind",
      "model",
      "operation",
      "parameters"
    ],
    "mediaFilterMatchesDeclaredSchemaOnly": true,
    "filterNeverImpliesPriceAuthorizationOrQuality": true,
    "evaluationDiscovery": "explicit_reviewed_model_visibility_only",
    "audioDiscovery": "explicit_reviewed_model_visibility_only",
    "modelCatalogRequiresAuthentication": true,
    "groupGuidance": {
      "command": "model-groups",
      "url": "https://console.puretokensx.com/api/product/docs/model-catalog",
      "method": "GET",
      "requiresConfiguredApiKey": false,
      "readsHostConfiguration": false,
      "requiresBrowserSession": false,
      "maxRequests": 1,
      "deadlineSeconds": 20,
      "followsRedirects": false,
      "neverRetry": true,
      "requestSchema": "schemas/model-groups-request.schema.json",
      "responseSchema": "schemas/model-groups-receipt.schema.json",
      "source": "exact_model_name_group_guidance_public_catalog_with_switch_display_names",
      "permissionVerified": false,
      "accountEligibilityVerified": false,
      "missingOrConflictingMapping": "generic_exact_model_guidance_without_invented_group_names",
      "configurationChange": "user_preserves_existing_groups_selects_allowed_group_and_verifies_applies_in_switch",
      "ordinaryGenerationPreflight": false,
      "automaticTaskSubmission": false
    }
  }
}
