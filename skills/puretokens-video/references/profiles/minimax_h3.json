{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "video",
  "catalogUpdatedAt": "2026-10-18",
  "catalogCapturedAt": "2026-10-18T12:22:09.975Z",
  "id": "minimax_h3",
  "parameterSchema": {
    "properties": {
      "prompt": {
        "type": "string",
        "required": true,
        "maxLength": 7000
      },
      "duration": {
        "type": "integer",
        "default": 15,
        "min": 4,
        "max": 15
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "21:9",
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "9:21",
          "adaptive"
        ],
        "default": "16:9"
      },
      "image_urls": {
        "type": "string[]",
        "maxLength": 9
      },
      "audio_urls": {
        "type": "string[]",
        "maxLength": 3
      },
      "video_urls": {
        "type": "string[]",
        "maxLength": 3
      },
      "first_frame_image": {
        "type": "string"
      },
      "last_frame_image": {
        "type": "string"
      }
    },
    "constraints": {
      "reference_transport": {
        "image_urls": [
          "public_https_url"
        ],
        "audio_urls": [
          "public_https_url"
        ],
        "video_urls": [
          "public_https_url"
        ],
        "first_frame_image": [
          "public_https_url",
          "max_1"
        ],
        "last_frame_image": [
          "public_https_url",
          "max_1"
        ]
      },
      "frame_exclusivity": {
        "last_frame_image": [
          "requires_first_frame_image"
        ],
        "first_frame_image": [
          "cannot_mix_reference_images_videos_audios"
        ]
      }
    },
    "lifecycle": {
      "create": {
        "successStatus": 200,
        "idField": "id",
        "object": "video",
        "initialStatuses": [
          "queued",
          "in_progress"
        ]
      },
      "poll": {
        "method": "GET",
        "path": "/v1/videos/{task_id}",
        "intervalSeconds": 5,
        "statusField": "status",
        "pendingStatuses": [
          "queued",
          "in_progress"
        ],
        "successStatuses": [
          "completed"
        ],
        "failureStatuses": [
          "failed"
        ],
        "resultFields": [
          "metadata.url"
        ]
      }
    },
    "operations": {
      "video_generation": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt"
        ],
        "inputs": {
          "reference_images": {
            "field": "reference_images",
            "minItems": 0,
            "maxItems": 9,
            "transports": [
              "https_url"
            ]
          },
          "reference_videos": {
            "field": "reference_videos",
            "minItems": 0,
            "maxItems": 3,
            "transports": [
              "https_url"
            ]
          },
          "reference_audios": {
            "field": "reference_audios",
            "minItems": 0,
            "maxItems": 3,
            "transports": [
              "https_url"
            ]
          }
        }
      },
      "image_to_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "first_frame_image"
        ],
        "inputs": {
          "first_frame_image": {
            "field": "first_frame_image",
            "required": true,
            "minItems": 1,
            "maxItems": 1,
            "transports": [
              "multipart_file"
            ]
          },
          "last_frame_image": {
            "field": "last_frame_image",
            "minItems": 0,
            "maxItems": 1,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_image_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_images"
        ],
        "inputs": {
          "reference_images": {
            "field": "reference_images",
            "required": true,
            "minItems": 1,
            "maxItems": 9,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_audio": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_audios"
        ],
        "inputs": {
          "reference_audios": {
            "field": "reference_audios",
            "required": true,
            "minItems": 1,
            "maxItems": 3,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_videos"
        ],
        "inputs": {
          "reference_videos": {
            "field": "reference_videos",
            "required": true,
            "minItems": 1,
            "maxItems": 3,
            "transports": [
              "multipart_file"
            ]
          }
        }
      }
    }
  }
}
