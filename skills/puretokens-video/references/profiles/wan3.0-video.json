{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "video",
  "catalogUpdatedAt": "2026-10-21",
  "catalogCapturedAt": "2026-10-21T02:29:21.846Z",
  "id": "wan3.0-video",
  "parameterSchema": {
    "properties": {
      "prompt": {
        "type": "string",
        "required": true
      },
      "duration": {
        "type": "integer",
        "min": 2,
        "max": 30
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4",
          "3:2",
          "2:3",
          "21:9",
          "9:21",
          "adaptive"
        ],
        "default": "16:9"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "480p",
          "720p",
          "1080p"
        ]
      },
      "reference_images": {
        "type": "string[]",
        "maxLength": 10
      },
      "reference_videos": {
        "type": "string[]",
        "maxLength": 5
      },
      "reference_audios": {
        "type": "string[]",
        "maxLength": 5
      },
      "first_frame_image": {
        "type": "string"
      }
    },
    "constraints": {
      "reference_transport": {
        "first_frame_image": [
          "public_https_url",
          "max_1"
        ],
        "reference_images": [
          "public_https_url",
          "max_10"
        ],
        "reference_videos": [
          "public_https_url",
          "max_5"
        ],
        "reference_audios": [
          "public_https_url",
          "max_5"
        ]
      },
      "unsupported_inputs": {
        "last_frame_image": [
          "not_supported"
        ]
      }
    },
    "lifecycle": {
      "create": {
        "successStatus": 200,
        "idField": "id",
        "object": "video",
        "initialStatuses": [
          "queued",
          "in_progress"
        ]
      },
      "poll": {
        "method": "GET",
        "path": "/v1/videos/{task_id}",
        "intervalSeconds": 5,
        "statusField": "status",
        "pendingStatuses": [
          "queued",
          "in_progress"
        ],
        "successStatuses": [
          "completed"
        ],
        "failureStatuses": [
          "failed"
        ],
        "resultFields": [
          "metadata.url"
        ]
      }
    },
    "operations": {
      "video_generation": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "application/json"
        },
        "requiredBodyFields": [
          "model",
          "prompt"
        ],
        "inputs": {
          "reference_images": {
            "field": "reference_images",
            "minItems": 0,
            "maxItems": 10,
            "transports": [
              "https_url"
            ]
          },
          "reference_videos": {
            "field": "reference_videos",
            "minItems": 0,
            "maxItems": 5,
            "transports": [
              "https_url"
            ]
          },
          "reference_audios": {
            "field": "reference_audios",
            "minItems": 0,
            "maxItems": 5,
            "transports": [
              "https_url"
            ]
          }
        }
      },
      "image_to_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "first_frame_image"
        ],
        "inputs": {
          "first_frame_image": {
            "field": "first_frame_image",
            "required": true,
            "minItems": 1,
            "maxItems": 1,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_image_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_images"
        ],
        "inputs": {
          "reference_images": {
            "field": "reference_images",
            "required": true,
            "minItems": 1,
            "maxItems": 10,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_videos"
        ],
        "inputs": {
          "reference_videos": {
            "field": "reference_videos",
            "required": true,
            "minItems": 1,
            "maxItems": 5,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_audio": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_audios"
        ],
        "inputs": {
          "reference_audios": {
            "field": "reference_audios",
            "required": true,
            "minItems": 1,
            "maxItems": 5,
            "transports": [
              "multipart_file"
            ]
          }
        }
      }
    }
  }
}
