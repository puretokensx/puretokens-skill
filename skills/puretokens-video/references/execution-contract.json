{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "video",
  "transport": {
    "fixedApiOrigin": "https://api.puretokensx.com",
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "credentialSourceNeverBecomesRequestTarget": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "requiresNativeMediaByteDelivery": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "executionStart": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request",
    "whenManagedNativeExecutorUnavailable": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
  },
  "operations": {
    "catalog": {
      "method": "GET",
      "url": "https://api.puretokensx.com/v1/media/models"
    },
    "submit": {
      "method": "POST",
      "url": "https://api.puretokensx.com/v1/videos",
      "requiredBodyFields": [
        "model",
        "prompt"
      ],
      "conditionalBodyFields": {
        "all_other_user_optional_fields": "only_when_the_installed_exact_model_index_and_selected_profile_or_an_on_demand_live_input_schema_declares_the_field_and_value"
      },
      "contentType": "profile_declared_json_or_multipart"
    },
    "edit": {
      "method": "POST",
      "url": "https://api.puretokensx.com/v1/videos/edits",
      "contentType": "multipart/form-data",
      "requiresDeclaredProfileOperation": "video_edit",
      "requiredBodyFields": [
        "model",
        "prompt",
        "video"
      ],
      "inputSource": "current_user_explicit_native_media_only",
      "transport": "profile_declared_multipart_file"
    },
    "status": {
      "method": "GET",
      "urlTemplate": "https://api.puretokensx.com/v1/videos/{task_id}"
    },
    "content": {
      "method": "GET",
      "urlTemplate": "https://api.puretokensx.com/v1/videos/{task_id}/content"
    }
  },
  "result": {
    "successRequires": "native_video_bytes",
    "notSuccess": [
      "task_id",
      "status_text",
      "html",
      "svg",
      "component",
      "remote_url"
    ],
    "sameTaskOnly": true,
    "neverAutoResubmit": true
  },
  "taskIdentity": {
    "receiptField": "task_id",
    "topLevelResponseFields": [
      "task_id",
      "id"
    ],
    "acceptedFormat": "^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,255}$(?![\\s\\S])",
    "neverDerivesIdFromUrlsNestedObjectsOrPrompt": true,
    "pathEncoding": "percent_encode_opaque_id_as_one_path_segment",
    "whenMissing": "report_task_id_not_returned_and_do_not_poll_download_or_resubmit"
  },
  "taskState": {
    "reconciliationRequiredField": "reconciliation_required",
    "reconciliationPrecedesLifecycle": true,
    "whenReconciliationRequired": "stop_ordinary_polling_retain_same_task_id_do_not_submit_replacement_or_infer_refund",
    "whenUnrecognized": "report_unknown_state_stop_automatic_polling_and_require_explicit_same_task_continuation",
    "pendingStates": [
      "pending",
      "queued",
      "processing",
      "running",
      "in_progress"
    ],
    "successStates": [
      "completed",
      "succeeded",
      "success"
    ],
    "failureStates": [
      "failed",
      "cancelled",
      "canceled",
      "expired",
      "error"
    ]
  },
  "contentRetrieval": {
    "fetchOnlyAfterTerminalSuccess": true,
    "oneInFlightContentReadPerTask": true,
    "neverPrefetchOrRefetchDeliveredContent": true,
    "handoffBeforeNextContentRead": true,
    "existingOutputReuse": "explicit_record_matching_sha256_bytes_media_type_only_otherwise_preserve_and_choose_another_directory"
  },
  "parameterValidation": {
    "defaultModel": "minimax_h3",
    "normalSubmissionUsesSelectedProfileAndIndexWhenNeeded": true,
    "exactModelCoreSubmissionDoesNotRequireCatalogPreflight": true,
    "onDemandLiveCatalogRead": "only_for_explicit_discovery_installed_profile_gap_or_post_rejection_diagnosis",
    "allModelsOptionalParametersRequire": "selected_profile_with_model_index_only_for_selection_parameter_schema_or_on_demand_live_input_schema",
    "resolutionUsesInstalledOrOnDemandModeConstraint": true,
    "whenProfileIsMissing": "do_not_submit_requested_optional_parameters_or_media_operations",
    "explicitPreflightCommand": "preflight --host <host-id> --request <request-file>; never POST; not a normal-generation preflight",
    "promptRequired": true
  },
  "inputMediaValidation": {
    "imageToVideoOperation": "image_to_video",
    "referenceImageVideoOperation": "reference_image_video",
    "referenceVideoOperation": "reference_video",
    "referenceAudioOperation": "reference_audio",
    "videoEditOperation": "video_edit",
    "explicitFirstFrameIntentUses": "image_to_video",
    "declaredGenerateAudioIntent": "map_explicit_generated_sound_to_true_and_silence_to_false_only_for_declared_boolean_generate_audio",
    "requiresInstalledOrOnDemandProfileOperation": true,
    "onlyCurrentUserExplicitMedia": true,
    "skillNeverDownloadsOrRehostsMedia": true,
    "hostStagesCurrentRequestAttachment": true,
    "nativeAttachmentRouteMustMatchDeclaredOperation": true,
    "nativeAttachmentMustNeverFallBackToJsonTextSubmission": true,
    "nativeAttachmentBodyMode": "executor_multipart_only",
    "whenCurrentAttachmentPathUnavailable": "stop_before_post_and_explain_declared_multipart_requirement",
    "multipleNativeAttachmentTypesRequireOneDeclaredCombinedOperation": true,
    "whenTransportUnavailable": "do_not_submit_and_explain_declared_transport",
    "publicUrlReferenceRequires": "selected_profile_with_model_index_only_for_selection_or_on_demand_live_profile_property_and_declared_reference_transport",
    "nativeAttachmentTransports": [
      "multipart_file"
    ],
    "publicReferenceTransports": [
      "public_https_url"
    ],
    "skillPassesUserProvidedPublicUrlsWithoutDownloadingOrRehosting": true,
    "multiplePublicUrlFieldsRequireNoDeclaredConflict": true,
    "attachmentIntegrity": "verify_file_identity_size_and_digest_before_and_during_multipart_no_hidden_copy"
  },
  "polling": {
    "serverDelay": "honor_valid_positive_retry_after_before_fallback",
    "serverDelayMustFitRemainingAutomaticDeadline": true,
    "afterHttp429": "honor_valid_positive_retry_after_then_continue_same_task_if_remaining_budget",
    "fallbackDelaysSeconds": [
      5,
      10,
      20,
      40,
      60
    ],
    "steadyDelaySeconds": 60,
    "automaticDeadlineSeconds": 300,
    "maxAutomaticStatusReads": 7,
    "oneInFlightStatusReadPerTask": true,
    "automaticPollingScope": "submission_or_explicit_same_task_continuation_turn_only_no_background_timer_or_queue",
    "afterStatusReadError": "stop_on_5xx_transport_or_timeout_and_require_explicit_same_task_continuation",
    "explicitContinuation": "explicit_user_request_allows_another_bounded_window_without_resetting_automatic_budget",
    "afterDeadline": "successful_pending_window_receipt_one_foreground_continuation_then_ask",
    "maxForegroundWaitWindows": 2,
    "windowProgressField": "wait_windows_completed_saturates_at_2_preserved_in_receipts_requests_records",
    "afterLongServerWait": "successful_retry_deferred_receipt_preserve_retry_not_before_offer_later_continuation"
  },
  "submissionFailure": {
    "modelParameterOrCapabilityRejection": "one_on_demand_catalog_read_then_require_explicit_corrected_new_request",
    "rateLimit": "report_retry_after_when_returned_and_require_explicit_retry",
    "serverTransportOrTimeoutWithoutTaskId": "report_submission_outcome_unknown_without_declaring_task_absent_or_resubmitting",
    "hostExecutionPolicyBlockedBeforeRequestStarts": "report_validation_no_api_request_or_task_id_and_require_host_session_with_external_network_permission",
    "hostInvocationOutputUnknown": "treat_submission_outcome_as_unknown_do_not_repeat_post_or_submit_replacement_task",
    "hostUnknownOutcomeResponse": "one_unknown_receipt_then_only_local_request_cleanup_no_further_api_or_task_work",
    "noTaskIdLaterContinuation": "require_explicit_confirmation_of_a_new_billable_request_before_one_new_post",
    "modelAlternatives": {
      "guide": "references/model-alternatives.md",
      "scope": [
        "image",
        "video"
      ],
      "offerAfter": "confirmed_model_or_capability_rejection_or_terminal_failure_without_blocking_cause",
      "doNotProactivelyOfferFor": [
        "unknown_submission",
        "status_read_failure",
        "reconciliation_required",
        "pending",
        "cancelled",
        "content_or_handoff_failure",
        "local_host_or_attachment_failure",
        "authentication_or_permission_denial",
        "balance_or_quota",
        "rate_limit",
        "content_rejection"
      ],
      "candidateEvidence": "same_current_connection_authenticated_catalog_and_executor_supported_profile_matching_all_required_inputs",
      "catalogRead": "reuse_valid_current_evidence_or_one_post_rejection_query_otherwise_require_explicit_discovery_request",
      "visibilityIsNotPermissionOrHealthProof": true,
      "preservesPromptMediaAndRequiredCapabilities": true,
      "requiresExplicitNewTaskConsent": true,
      "disclosesPossibleNewCharge": true,
      "automaticModelSwitch": false,
      "taskIdentity": "one_new_submission_with_new_task_identity_and_separate_record_preserving_original",
      "noAutomaticModelRotation": true
    }
  },
  "failureReceipt": {
    "requiredFields": [
      "failure_phase",
      "error_message",
      "next_action"
    ],
    "allowedFailurePhases": [
      "validation",
      "submission",
      "status",
      "content"
    ],
    "httpStatus": "numeric_only_when_returned_otherwise_omit",
    "apiErrorCode": "recognized_public_category_code_only_when_explicitly_returned_otherwise_omit",
    "errorMessage": "fixed_public_category_message_or_fixed_local_explanation_never_arbitrary_server_text",
    "retryAfterSeconds": "include_when_a_valid_positive_retry_after_is_returned",
    "forbiddenDisclosure": [
      "raw_response_body",
      "upstream_or_provider_identifier",
      "internal_hostname_or_url",
      "stack_trace",
      "request_headers",
      "request_body",
      "credentials_or_session_data",
      "user_reference_url_or_attachment_bytes"
    ],
    "nextAction": "curated_category_specific_action_preserving_submission_uncertainty_and_same_task_recovery"
  },
  "unsupportedInput": [
    "undeclared_media_operation",
    "undeclared_combined_media_operation",
    "non_current_user_media"
  ],
  "continuationRecord": {
    "optional": true,
    "location": "explicit_absolute_user_or_workspace_artifact",
    "commands": [
      "status",
      "wait",
      "resume",
      "content",
      "delivered"
    ],
    "preserves": [
      "kind",
      "task_id",
      "model",
      "original_operation",
      "requested_count",
      "safe_parameters",
      "output_directory",
      "downloaded_indexes",
      "download_proofs",
      "delivered_indexes",
      "retry_not_before",
      "reconciliation_required",
      "wait_windows_completed"
    ],
    "excludes": [
      "credentials",
      "prompt",
      "reference_urls",
      "attachment_bytes"
    ],
    "resumeNeverSubmits": true,
    "deliveryRequiresActualHostHandoff": true,
    "validatesBeforeCreation": true,
    "downloadProofFields": [
      "sha256",
      "bytes",
      "media_type"
    ],
    "reuseRequiresMatchingProof": true,
    "legacyRecordWithoutProof": "continue_same_task_but_download_into_another_directory_before_handoff",
    "unknownSubmissionNeverResubmits": true
  }
}
