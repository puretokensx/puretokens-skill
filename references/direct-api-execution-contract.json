{
  "$schema": "https://puretokensx.com/schemas/direct-api-execution-contract.schema.json",
  "schemaVersion": 1,
  "apiOrigin": "https://api.puretokensx.com",
  "authentication": {
    "usesCurrentHostConfiguredCredential": true,
    "executorCredentialAdapterHosts": [
      "claude-code",
      "codex",
      "workbuddy",
      "gemini-cli",
      "grok-build",
      "opencode",
      "claude-desktop",
      "dsh-desktop",
      "deepseek-harness",
      "minimax-code",
      "zcode",
      "kimi-code",
      "qoder",
      "pi",
      "hermes",
      "evox",
      "vscode",
      "octop"
    ],
    "credentialUse": "in_memory_only_for_fixed_puretokens_api_requests",
    "credentialSourceMustMatchFixedPureTokensEndpoint": true,
    "credentialSourceNeverBecomesRequestTarget": true,
    "neverDisplaysCopiesStoresOrRequestsCredentials": true,
    "resolvesCurrentHostConnectionCredentialInMemoryForFixedRequest": true,
    "neverScansForCredentials": true
  },
  "transport": {
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "executorIsOneShot": true,
    "doesNotRequireNode": true,
    "doesNotUseMcp": true,
    "doesNotUseLocalProxyOrSidecar": true,
    "doesNotUseFallbackEndpoint": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "executionStart": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request",
    "whenManagedNativeExecutorUnavailable": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
  },
  "mediaRouting": {
    "imageAndVideoRequestsPreferPureTokensSpecialists": true,
    "imageSkill": "puretokens-image",
    "videoSkill": "puretokens-video",
    "priority": "when_current_host_connection_uses_puretokens_select_the_matching_puretokens_specialist_before_generic_imagegen_imagen_or_video_skills",
    "afterSpecialistSelection": "never_fall_back_to_a_generic_media_skill",
    "connectionContext": "managed_native_executor_resolves_one_matching_current_connection_credential_privately_for_the_fixed_request",
    "metadataLimitation": "skill_metadata_expresses_routing_priority_but_cannot_override_a_host_that_ignores_installed_skill_selection"
  },
  "installableHosts": [
    "claude-code",
    "codex",
    "workbuddy",
    "gemini-cli",
    "grok-build",
    "opencode",
    "trae",
    "claude-desktop",
    "dsh-desktop",
    "deepseek-harness",
    "minimax-code",
    "zcode",
    "kimi-code",
    "qoder",
    "pi",
    "hermes",
    "evox",
    "vscode",
    "octop"
  ],
  "executorCredentialAdapterHosts": [
    "claude-code",
    "codex",
    "workbuddy",
    "gemini-cli",
    "grok-build",
    "opencode",
    "claude-desktop",
    "dsh-desktop",
    "deepseek-harness",
    "minimax-code",
    "zcode",
    "kimi-code",
    "qoder",
    "pi",
    "hermes",
    "evox",
    "vscode",
    "octop"
  ],
  "requiredExecutorCapabilities": [
    "fixed_full_url_request",
    "json_task_response",
    "same_task_status_read",
    "native_media_byte_delivery",
    "bounded_local_resource_use"
  ],
  "acceptanceScenarios": [
    {
      "id": "api-identity-read",
      "request": "executor GET https://api.puretokensx.com/v1",
      "expect": "uses a verified active-host credential adapter only in memory and returns the API identity JSON"
    },
    {
      "id": "catalog-read",
      "request": "executor GET https://api.puretokensx.com/v1/media/models",
      "expect": "returns the authenticated media catalog only for explicit discovery, an installed-profile gap, or post-rejection diagnosis"
    },
    {
      "id": "media-submit",
      "request": "executor POST the fixed Images or Videos API URL once with the selected model and declared request body",
      "expect": "normal core text generation submits directly without a catalog preflight and returns a JSON task response"
    },
    {
      "id": "same-task-status",
      "request": "executor GET a submitted task's fixed full status or content URL",
      "expect": "continues only the supplied task_id and never submits a replacement task"
    },
    {
      "id": "native-media-delivery",
      "request": "executor GET a completed task's fixed full content URL",
      "expect": "the executor delivers validated native media bytes; URLs, HTML, SVG, task IDs, and status text are not completed delivery"
    },
    {
      "id": "executor-request-start",
      "request": "a fixed API request is needed",
      "expect": "invokes the checksum-verified managed executor; it never asks the model to read credentials, assemble a curl request, or search for another interface"
    }
  ],
  "userMediaInput": {
    "onlyCurrentUserExplicitMedia": true,
    "publicUrlImageEditRequiresExactDeclaredJsonOperation": true,
    "requiresInstalledOrOnDemandDeclaredTransport": true,
    "skillNeverDownloadsOrRehosts": true,
    "executorSendsDeclaredMultipartAttachmentsDirectly": true,
    "nativeAttachmentRouteMustMatchDeclaredOperation": true,
    "nativeAttachmentMustNeverFallBackToJsonTextSubmission": true,
    "untransportableNativeReferenceMustNeverBeConvertedToTextPrompt": true,
    "currentRequestScopeOnly": true,
    "fallback": "If the executor cannot receive an explicitly attached file by absolute path through the declared multipart representation, stop before submission, explain the declared transport, and do not invent a URL, file ID, or upload path.",
    "publicUrlRequiresInstalledOrOnDemandProfilePropertyAndTransport": true
  },
  "supportSummary": {
    "format": "puretokens-support-v1",
    "source": "current_invocation_receipt_and_latest_http_attempt_only",
    "requestIdHeaders": [
      "X-Request-ID",
      "X-Oneapi-Request-Id"
    ],
    "requestIdRule": "one_canonical_lowercase_uuid_legacy_only_if_standard_absent_omit_conflicts",
    "neverUseUpstreamRequestId": true,
    "noAdditionalIO": true,
    "noAutomaticExportOrUpload": true,
    "neverUseAsTaskRecordOrIdempotencyKey": true,
    "privateSupportOnly": true
  },
  "asyncTaskHandling": {
    "providerProtocolOwner": "gateway",
    "publicImageContract": "submit_once_receive_durable_task_id_then_read_same_task_status_and_protected_content",
    "asyncFlagMeaning": "product_task_compatibility_not_supplier_async_capability",
    "neverSendInternalWorkspaceDeliveryHeaders": true,
    "neverSwitchToSynchronousProviderTransport": true,
    "reconciliationOutcome": "stop_ordinary_polling_retain_same_task_id_do_not_submit_replacement_or_infer_refund",
    "submissionOutputUnknown": "treat_submission_outcome_as_unknown_do_not_repeat_post_or_submit_replacement_task",
    "statusHttp429": "honor_valid_positive_retry_after_then_continue_same_task_if_remaining_budget",
    "non429StatusReadFailure": "stop_bounded_window_without_replacement_task",
    "doesNotInventApiErrorCode": true,
    "reconciliationRequiredPrecedesStateClassification": true,
    "identityDiagnostics": {
      "task_response_unreadable": "The response could not be fully read, safely processed or parsed as a JSON object.",
      "task_id_missing": "No non-empty top-level task_id or id was found; do not search nested structures.",
      "task_id_invalid": "An identity field was returned but its type or format is unsupported; never expose or rewrite the rejected value."
    },
    "identityDiagnosticBoundary": "Local error codes never imply task absence or billing outcome; unknown submission stops without another request. Status failures retain the original task identity and stop automatic continuation. Use the actual failing executor version from the existing support summary, never another computer or the repository version.",
    "modelAlternatives": {
      "guide": "references/model-alternatives.md",
      "scope": [
        "image",
        "video"
      ],
      "offerAfter": "confirmed_model_or_capability_rejection_or_terminal_failure_without_blocking_cause",
      "doNotProactivelyOfferFor": [
        "unknown_submission",
        "status_read_failure",
        "reconciliation_required",
        "pending",
        "cancelled",
        "content_or_handoff_failure",
        "local_host_or_attachment_failure",
        "authentication_or_permission_denial",
        "balance_or_quota",
        "rate_limit",
        "content_rejection"
      ],
      "candidateEvidence": "same_current_connection_authenticated_catalog_and_executor_supported_profile_matching_all_required_inputs",
      "catalogRead": "reuse_valid_current_evidence_or_one_post_rejection_query_otherwise_require_explicit_discovery_request",
      "visibilityIsNotPermissionOrHealthProof": true,
      "preservesPromptMediaAndRequiredCapabilities": true,
      "requiresExplicitNewTaskConsent": true,
      "disclosesPossibleNewCharge": true,
      "automaticModelSwitch": false,
      "taskIdentity": "one_new_submission_with_new_task_identity_and_separate_record_preserving_original",
      "noAutomaticModelRotation": true
    }
  },
  "mediaDeliveryResourceBounds": {
    "oneInFlightStatusReadPerTask": true,
    "noBackgroundPollingOrQueue": true,
    "readContentOnlyAfterTerminalSuccess": true,
    "oneInFlightContentReadPerTask": true,
    "sequentialImageContentIndexes": true,
    "neverPrefetchOrRefetchDeliveredContent": true,
    "handoffNativeBytesBeforeNextRead": true,
    "doesNotPersistMediaBytesInSkillStateOrLogs": true,
    "confirmedDeliveryEndsCurrentResponse": true,
    "pngJpegValidation": "bounded_standard_decoder_checks_pixel_payload_before_download_success_and_proof_reuse",
    "maxPngJpegDecodedPixels": 33554432,
    "webpValidation": "complete_container_and_nonempty_frame_payload_checks_not_full_codec_decode",
    "fallback": "If the executor cannot hand off validated native media bytes, report same-task delivery as unavailable. Do not substitute a URL, HTML, SVG, status text, or a re-submitted task."
  },
  "balance": {
    "url": "https://console.puretokensx.com/api/product/console/api-keys/usage",
    "method": "GET",
    "requiresConfiguredApiKey": true,
    "requiresBrowserSession": false,
    "responseSchema": "schemas/balance-snapshot.schema.json",
    "unitMetadataUrl": "https://console.puretokensx.com/api/product/console/status",
    "unitMetadataRequiresConfiguredApiKey": false,
    "maxRequests": 2,
    "deadlineSeconds": 30,
    "scopeRule": "unlimited_quota_true_account_wallet_else_key_allowance",
    "unit": "USD",
    "includesSubscriptionQuota": false,
    "calculation": "each_returned_quota_divided_by_public_quota_per_unit_in_USD_never_subtract_used_from_available",
    "fallback": "On an actual API, format or unit-metadata failure, report the sanitized balance-specific reason without an amount or automatic retry. A balance 401/403 does not prove the current Key or media connection is invalid. If other API calls work, preserve the connection and suggest Pure Tokens support; otherwise offer a later query or the console. Never estimate or request credentials.",
    "bearerNormalization": "add_sk_prefix_if_missing_in_memory_for_usage_header_only"
  },
  "optionalCommands": {
    "preflight": "Explicit request check only; never media POST, may read one catalog for a profile gap. Existing local type/range/enum failures are not automatically relaxed.",
    "modelQuery": "One explicit authenticated catalog read. Shares parameter and cross-field rules with submission, infers required operation inputs, but does not validate actual attachment bytes or rewrite installed profiles.",
    "modelDeclarationRefresh": "Explicit exact-model query then user-requested compatible stable update; no automatic profile mutation, preflight or media resubmission.",
    "doctor": "Explicit diagnostics: local managed install checks and existing read-only init checks; no paid task.",
    "filteredModels": "One explicit authenticated catalog GET, filtered by declared kind/model/operation/parameters.",
    "taskRecord": "Explicit absolute user/workspace JSON with task identity, validated safe continuation metadata, and per-index download SHA-256/byte count/media type; never credentials, prompt, reference URLs or media bytes.",
    "resume": "Reads only the recorded task; never discovers tasks or submits replacements.",
    "delivered": "Local progress acknowledgment only after actual host handoff."
  },
  "unimplementedServerDependencies": {
    "exactQuote": "No authoritative media price quote endpoint is implemented by this repository.",
    "idempotentSubmit": "No server idempotency guarantee is implemented; unknown submissions must not be repeated automatically.",
    "unknownTaskLookup": "No task discovery exists for submissions that returned no task ID.",
    "modelRetirement": "No authoritative retirement date/status/replacement contract is consumed. Web/gateway must define authenticated catalog semantics before Skill adaptation; input_schema.lifecycle describes task polling, not model retirement. Never infer retirement from a missing catalog entry."
  },
  "evaluation": {
    "method": "POST",
    "url": "https://api.puretokensx.com/typesafe/v1/systemone",
    "command": "evaluate",
    "deadlineSeconds": 90,
    "maxRequests": 1,
    "requestSchema": "schemas/evaluation-request.schema.json",
    "responseSchema": "schemas/evaluation-receipt.schema.json",
    "modelDiscoveryUrl": "https://api.puretokensx.com/v1/models",
    "modelDiscoveryScope": "explicit_reviewed_model_visibility_only",
    "synchronous": true,
    "neverAutomaticallyRetries": true,
    "onePostPerInvocation": true,
    "neverPoll": true
  },
  "audio": {
    "commands": [
      "audio",
      "audio-verify"
    ],
    "urls": [
      "https://api.puretokensx.com/v1/audio/speech",
      "https://api.puretokensx.com/v1/audio/transcriptions",
      "https://api.puretokensx.com/v1/audio/generate"
    ],
    "method": "POST",
    "deadlineSeconds": 90,
    "maxRequests": 1,
    "synchronous": true,
    "neverAutomaticallyRetries": true,
    "neverPoll": true,
    "modelDiscoveryUrl": "https://api.puretokensx.com/v1/models",
    "modelDiscoveryScope": "explicit_reviewed_model_visibility_only",
    "requestSchema": "schemas/audio-request.schema.json",
    "responseSchema": "schemas/audio-receipt.schema.json",
    "verifySchema": "schemas/audio-artifact-verify-request.schema.json",
    "verifyLocalOnly": true,
    "nativeAudioBytesRequired": true,
    "downloadIsNotDelivery": true
  },
  "operationsReceipts": {
    "enabledByDefault": false,
    "enablement": "PTP_OPERATIONS_RECEIPTS=1",
    "url": "https://console.puretokensx.com/api/product/analytics/client-receipts",
    "method": "POST",
    "schemaVersion": 1,
    "fields": [
      "schemaVersion",
      "id",
      "source",
      "event",
      "platform",
      "occurredAt"
    ],
    "source": "skill",
    "events": [
      "installed",
      "connection_verified",
      "execution_succeeded",
      "execution_failed"
    ],
    "authentication": "none",
    "readsHostConfiguration": false,
    "persistentIdentifier": false,
    "deadlineSeconds": 1,
    "retries": 0,
    "durableQueue": false,
    "changesBusinessResult": false,
    "asyncSuccessMeaning": "submission_accepted_not_output_delivered",
    "initBudget": "outside_existing_two_reads_and_twenty_seconds"
  },
  "music": {
    "kind": "music",
    "model": "stepaudio-3-music-preview",
    "submitUrl": "https://api.puretokensx.com/v1/audio/music/submit",
    "statusUrlTemplate": "https://api.puretokensx.com/v1/audio/music/tasks/{task_id}",
    "contentUrlTemplate": "https://api.puretokensx.com/v1/audio/music/tasks/{task_id}/content",
    "asynchronous": true,
    "onePostPerSubmission": true,
    "neverAutomaticallyResubmits": true,
    "recordRequiredBySkill": true,
    "recordExcludesPromptAndLyrics": true,
    "apiTaskBoundToOwnerAndOriginatingKey": true,
    "maxOutputBytes": 33554432,
    "artifactRetentionSeconds": 86400,
    "retentionStarts": "gateway_artifact_saved_at",
    "waitWindowMaxReads": 7,
    "waitWindowDeadlineSeconds": 300,
    "maxAutomaticWaitWindows": 2,
    "reconciliationStopsAutomaticContinuation": true,
    "downloadIsNotDelivery": true
  },
  "modelGroupGuidance": {
    "command": "model-groups",
    "url": "https://console.puretokensx.com/api/product/docs/model-catalog",
    "method": "GET",
    "requiresConfiguredApiKey": false,
    "readsHostConfiguration": false,
    "requiresBrowserSession": false,
    "maxRequests": 1,
    "deadlineSeconds": 20,
    "followsRedirects": false,
    "neverRetry": true,
    "requestSchema": "schemas/model-groups-request.schema.json",
    "responseSchema": "schemas/model-groups-receipt.schema.json",
    "source": "exact_model_name_group_guidance_public_catalog_with_switch_display_names",
    "permissionVerified": false,
    "accountEligibilityVerified": false,
    "missingOrConflictingMapping": "generic_exact_model_guidance_without_invented_group_names",
    "configurationChange": "user_preserves_existing_groups_selects_allowed_group_and_verifies_applies_in_switch",
    "ordinaryGenerationPreflight": false,
    "automaticTaskSubmission": false
  }
}
